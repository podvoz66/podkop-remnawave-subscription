#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
    /usr/bin/podkop-failover-guard boot || return 1
    procd_open_instance
    procd_set_param command /usr/bin/podkop-failover-guard daemon
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
